# ManageAllTV kurulum ayarları. Bu dosyayı ".env" adıyla kopyalayıp doldurun:
#   cp .env.example .env && chmod 600 .env
# .env içinde parolalar var; git'e eklenmez, kimseyle paylaşmayın.

# Sunucunun alan adı. DNS'te bu ad için sunucunun IP adresini gösteren bir A kaydı olmalı.
# Caddy bu ad için Let's Encrypt sertifikasını kendisi alır ve yeniler.
# Panel: https://<DOMAIN>, TV'lerin bağlanacağı adres de aynısı.
DOMAIN=tv.ornek.com

# PostgreSQL parolası. Veritabanı bağlantı adresinin içine yazıldığı için YALNIZ harf ve rakam
# kullanın. Üretmek için: openssl rand -hex 24
# Not: ilk kurulumdan sonra burada değiştirmek veritabanındaki parolayı değiştirmez.
POSTGRES_PASSWORD=

# Oturum çerezlerini imzalar ve iki adımlı doğrulama sırlarını şifreler; en az 32 karakter.
# Üretmek için: openssl rand -base64 48
# Değiştirirseniz herkesin oturumu kapanır ve iki adımlı doğrulama yeniden kurulmalıdır.
BETTER_AUTH_SECRET=

# Yeni konumlar için önerilen saat dilimi.
DEFAULT_TIMEZONE=Europe/Istanbul

# Yüklenebilecek en büyük dosya (bayt). Varsayılan 4 GiB.
MAX_UPLOAD_BYTES=4294967296

# Sunucu günlük ayrıntısı: debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------- yedekleme (backup.sh)

# Yedeklerin yazılacağı klasör (bu sunucuda).
BACKUP_DIR=/var/backups/managealltv

# Veritabanı yedekleri ve silinen medyanın kopyaları kaç gün saklansın.
BACKUP_KEEP_DAYS=14

# İsteğe bağlı ama önerilir: yedeklerin sunucu dışındaki kopyası (rsync hedefi, SSH ile).
# Örnek: yedek@nas.ofis.local:/yedek/managealltv
BACKUP_RSYNC_TARGET=
