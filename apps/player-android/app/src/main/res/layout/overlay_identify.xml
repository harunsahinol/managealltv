<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/identify_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/overscan_horizontal"
    android:paddingTop="@dimen/overscan_vertical"
    android:paddingEnd="@dimen/overscan_horizontal"
    android:paddingBottom="@dimen/overscan_vertical"
    android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/identify_label"
        android:textColor="@color/text_primary"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/identify_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="3"
        android:textColor="@color/text_primary"
        android:textSize="96sp"
        android:textStyle="bold" />
</LinearLayout>
