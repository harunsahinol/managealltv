<?xml version="1.0" encoding="utf-8"?>
<!-- Debug build only: also allows plain http (a server on the developer's LAN) and user-installed
     CAs (debugging proxies). Release builds use src/main/res/xml/network_security_config.xml. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
