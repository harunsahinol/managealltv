{
  "name": "@managealltv/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "admin:invite": "tsx --env-file-if-exists=.env src/cli/create-admin-invite.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-validator": "^0.9.1",
    "@managealltv/protocol": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "6.19.3",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.5",
    "better-auth": "^1.7.9",
    "hono": "^4.13.13",
    "pg-boss": "^12.38.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "prisma": "6.19.3",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  }
}
