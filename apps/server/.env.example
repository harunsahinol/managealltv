# Copy to .env for local development (the dev/start scripts load it with --env-file-if-exists).

# PostgreSQL connection (Prisma + pg-boss). Do not add ?schema=... (pg-boss uses its own schema).
DATABASE_URL=postgresql://managealltv:managealltv@127.0.0.1:5432/managealltv

# At least 32 random characters, e.g. `openssl rand -base64 48`. Changing it signs everybody out.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Public origin of the panel + API (no trailing slash). Used for invite links, cookies (Secure when
# https) and CSRF/origin checks.
PUBLIC_URL=http://localhost:3000

PORT=3000

# Media storage root: uploads/, files/<id>.<ext>, thumbs/<id>.jpg
MEDIA_DIR=./data/media

# Largest accepted upload in bytes (4 GiB).
MAX_UPLOAD_BYTES=4294967296

# Time zone suggested for new locations.
DEFAULT_TIMEZONE=Europe/Istanbul

# ffmpeg / ffprobe executables used for media processing (PATH lookup unless absolute).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# debug | info | warn | error | silent
LOG_LEVEL=info

# true when running behind Caddy (or another proxy that overwrites X-Forwarded-For).
TRUST_PROXY=false

# Optional, comma separated: extra origins allowed to call /api/auth (e.g. http://localhost:5173 in dev).
EXTRA_TRUSTED_ORIGINS=
